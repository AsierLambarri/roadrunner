# Roadrunner pipeline configuration
# ==================================
# Run with: python scripts/run_pipeline_yaml.py --config path/to/this/file.yaml

# ── Data source ---------------------------------------------------------------
reader_type: npz                 # Data reader: yt (YT snapshots), pdata (HDF5 particle
npz_mock_sim: True                                #   data), npz (column-format .npy/.npz files)

# ── Data paths ───────────────────────────────────────────────────────────────
merger_tree_path: /home/asier/roadrunner/test_data/mock_simulation_tight/merger_tree.csv
equivalence_path: /home/asier/roadrunner/test_data/mock_simulation_tight/equivalence.csv
particle_data_dir: /home/asier/roadrunner/test_data/mock_simulation_tight/


# ── Simulation code & particle type (YT reader only) ─────────────────────────
code: RAMSES                  # Simulation code: ART, ART-I, GEAR, AURIGA,
                              #   AREPO, RAMSES, VINTERGATAN
ptype: star                   # Particle type to load (e.g. star, gas, dm)

# ── YT field name mapping (YT reader only) ────────────────────────────────────
fields:
  index: particle_index
  mass: particle_mass
  position: particle_position
  velocity: particle_velocity
  metallicity: particle_metallicity     # extra → saved to output, not in assigner

# ── Assigner fields (which loaded fields the assigner receives) ──────────────
assign_fields: [position, velocity]     # default if omitted

# ── Unit base (YT scaling, optional) ─────────────────────────────────────────
# unit_base:                    # Uncomment if needed
#   length: 1.0
#   velocity: 1.0
#   mass: 1.0

# ── Target halo ──────────────────────────────────────────────────────────────
# accretion_id: 12345          # Target Sub_tree_id (auto-detect if omitted)
# start_snapshot: 0            # First snapshot (or -5 for "5th from last")
# end_snapshot: 100            # Last snapshot (or -1 for "last")
# Particle selection (selection_snapshot/sphere/bbox) is supported by all readers (comoving kpc).

# ── Assigner ──────────────────────────────────────────────────────────────────
assignment_method: bgmm          # XGMM method: gmm (standard EM) or bgmm (variational Bayesian)
use_bgmm_priors: true           # Use previous snapshot as BGMM prior (bgmm only)
dtype_math: float64             # XGMM math precision: float32, float64, float128
cov_type: full                 # Covariance type: full, diagonal, spherical
max_iter: 10                   # Maximum EM iterations
tol: 1e-2                      # Convergence tolerance
min_particles: 10              # Minimum particles per group
reg_covar: 1e-6                # Regularization for covariance

# ── Physics ──────────────────────────────────────────────────────────────────
halo_model: kepler             # Potential model: kepler, nfw
n_los: 15                      # Number of lines of sight for properties
search_factor: 1.0             # Search radius multiplier (Rvir)
comoving: true                 # Merger tree positions in comoving kpc (true)
                               #   or physical kpc (false)

# ── Centering ────────────────────────────────────────────────────────────────
use_gmm_centers: true          # Use GMM-derived centers when available
min_particles_structural: 30   # Minimum particles for structural properties
ssc_nmin: 30                   # Minimum particles for shrink-sphere centering
ssc_alpha: 0.9                 # Shrink-sphere contraction factor (0-1)

# ── Dynstate (Riley criterion) ───────────────────────────────────────────────
dynstate_snapshots: [-2, -1]   # Which snapshots get dynstate:
                               #   null     → all snapshots
                               #   -1       → only last
                               #   [-2, -1] → last two
                               #   [0, 10]  → specific IDs
                               #   /path/snaps.txt → load from file

# ── Birth tracker ────────────────────────────────────────────────────────────
birth_window_factor: 5.0       # Birth scoring window (set ≤ 0 to disable)
enforce_initial_hosts: true    # Keep particles in initial host galaxy

# ── Output ───────────────────────────────────────────────────────────────────
output_dir: ~/roadrunner/output_npz/
resume: false                  # Resume from checkpoint (true/false)
save_particles: true           # Save particle positions/velocities to HDF5
save_assignment: true          # Save soft assignment data to HDF5
float_atol: 1e-4               # Floating-point precision for saved data
